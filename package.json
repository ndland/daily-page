{
  "name": "daily-page",
  "version": "0.1.1",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "vitest run && tsc --noEmit && node esbuild.config.mjs production",
    "dev": "node esbuild.config.mjs",
    "test": "vitest run",
    "harness": "esbuild harness/harness.ts --bundle --format=iife --target=es2020 --outfile=harness/dist/harness.js",
    "vault": "node scripts/build-vault.mjs",
    "release": "npm run build && node scripts/package-plugin.mjs",
    "audit": "npm audit --audit-level=high",
    "install:vault": "node scripts/install-vault.mjs",
    "release:check": "node scripts/check-versions.mjs",
    "release:prepare": "node scripts/release-prepare.mjs",
    "commit": "czg",
    "changelog": "conventional-changelog -p conventionalcommits -i CHANGELOG.md -r 0 --skip-unstable",
    "prepare": "husky"
  },
  "keywords": [],
  "author": "Nick Land",
  "license": "UNLICENSED",
  "description": "Hobonichi-style daily page for Obsidian",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "^26.6.6",
    "conventional-changelog": "^8.1.3",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "czg": "^1.14.0",
    "esbuild": "^0.28.2",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "obsidian": "^1.14.4",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "private": true
}
